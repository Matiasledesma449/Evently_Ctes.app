rules_version = '2';

// Reglas de Firebase Storage de Evently.
// Fotos de eventos: las puede ver cualquiera (se muestran a compradores sin sesión) y solo las sube
// la persona con sesión dueña de la carpeta, solo si son imágenes de hasta 3 MB. Todo lo demás queda cerrado.
service firebase.storage {
  match /b/{bucket}/o {
    match /eventos_solicitudes/{uid}/{archivo} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource != null
                   && request.resource.contentType.matches('image/(jpeg|png|webp)')
                   && request.resource.size < 3 * 1024 * 1024;
    }
  }
}
